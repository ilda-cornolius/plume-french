# Preferred: Google Gemini (free tier via Google AI Studio)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional LLM fallbacks
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google OAuth (Auth.js / NextAuth)
# 1. https://console.cloud.google.com/apis/credentials
# 2. Create OAuth client (Web application)
# 3. Authorized redirect URI: {ORIGIN}/api/auth/callback/google
#    e.g. http://127.0.0.1:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret for session encryption (required in production)
AUTH_SECRET=
# Public site URL (required in production / hosted deploy)
AUTH_URL=http://127.0.0.1:3000

# Encrypt AnkiWeb session cookie
PLUME_SESSION_SECRET=
